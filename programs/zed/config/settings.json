{
    "disable_ai": false,
    "edit_predictions": {
        "allow_data_collection": "no",
        "provider": "copilot"
    },
    "outline_panel": {
        "dock": "left"
    },
    "context_servers": {
        // "prefect": {
        //     "enabled": true,
        //     "command": "ssh",
        //     "args": [
        //         "-T",
        //         "-o",
        //         "BatchMode=yes",
        //         "main.main.mch-sb.coder",
        //         "/home/dp/.pyenv/shims/uvx",
        //         "--from",
        //         "prefect-mcp",
        //         "prefect-mcp-server"
        //     ]
        // },
        "prefect": {
            "enabled": true,
            "command": "ssh",
            "args": [
                "-T",
                "-o",
                "BatchMode=yes",
                "-o",
                "ServerAliveInterval=30",
                "main.main.mch-sb.coder",
                "/workspace/.home/bin/prefect-mcp"
            ]
        }
    },
    "agent": {
        "threads_sidebar": {
            "position": "right"
        },
        "limit_content_width": true,
        "max_content_width": 800,
        "default_width": 460,
        "flexible": false,
        "tool_permissions": {
            "tools": {
                "mcp:prefect:get_automations": {
                    "default": "allow"
                },
                "mcp:prefect:get_dashboard": {
                    "default": "allow"
                },
                "mcp:prefect:read_events": {
                    "default": "allow"
                },
                "delete_path": {
                    "default": "allow"
                },
                "move_path": {
                    "default": "allow"
                },
                "mcp:prefect:get_work_pools": {
                    "default": "allow"
                },
                "write_file": {
                    "default": "allow"
                },
                "mcp:prefect:get_task_runs": {
                    "default": "allow"
                },
                "mcp:prefect:get_flow_run_logs": {
                    "default": "allow"
                },
                "mcp:prefect:get_identity": {
                    "default": "allow"
                },
                "mcp:prefect:get_flow_runs": {
                    "default": "allow"
                },
                "mcp:prefect:get_deployments": {
                    "default": "allow"
                },
                "copy_path": {
                    "default": "allow"
                },
                "mcp:prefect:orientation": {
                    "default": "allow"
                },
                "create_directory": {
                    "default": "allow"
                },
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^grep\\b"
                        },
                        {
                            "pattern": "^head\\b"
                        },
                        {
                            "pattern": "^find\\b"
                        },
                        {
                            "pattern": "^cat\\b"
                        },
                        {
                            "pattern": "^yq\\b"
                        },
                        {
                            "pattern": "^sed\\b"
                        },
                        {
                            "pattern": "^sort\\b"
                        },
                        {
                            "pattern": "^ls\\b"
                        },
                        {
                            "pattern": "^awk\\b"
                        },
                        {
                            "pattern": "^echo\\b"
                        },
                        {
                            "pattern": "^git\\b"
                        },
                        {
                            "pattern": "^tail\\b"
                        },
                        {
                            "pattern": "^wc\\b"
                        },
                        {
                            "pattern": "^rg\\b"
                        },
                        {
                            "pattern": "^cd\\b"
                        },
                        {
                            "pattern": "^cut\\b"
                        },
                        {
                            "pattern": "^uniq\\b"
                        },
                        {
                            "pattern": "^xargs\\s+(grep|cat)(\\s|$)"
                        },
                        {
                            "pattern": "^uv\\s+run\\s+(--?[\\w-]+(=\\S+)?\\s+)*(prek|ty|ruff|pytest|pyright)(\\s|$)"
                        },
                        {
                            "pattern": "^uv\\s+pip\\s+compile\\b"
                        },
                        {
                            "pattern": "^pip\\s+(show)(\\s|$)"
                        },
                        {
                            "pattern": "^(\\./)?\\.venv/bin/python3?\\s+-m\\s+pytest\\b"
                        },
                        {
                            "pattern": "^which\\s+docker(\\s|$)"
                        },
                        {
                            "pattern": "^uv\\s+lock(\\s|$)"
                        },
                        {
                            "pattern": "^rm\\b"
                        },
                        {
                            "pattern": "^mkdir\\b"
                        },
                        {
                            "pattern": "^cp\\b"
                        },
                        {
                            "pattern": "^uv\\s+build(\\s|$)"
                        },
                        {
                            "pattern": "^uv\\s+sync(\\s|$)"
                        },
                        {
                            "pattern": "^docker\\s+(images|info|ps|buildx)(\\s|$)"
                        },
                        {
                            "pattern": "^git\\s+(archive|rm)(\\s|$)"
                        },
                        {
                            "pattern": "^tar\\b"
                        },
                        {
                            "pattern": "^gh\\s+(pr|run|issue|release)\\s+(list|view)(\\s|$)"
                        },
                        {
                            "pattern": "^dope\\s+workspace\\s+get(\\s|$)"
                        },
                        {
                            "pattern": "^get_django_config\\b"
                        },
                        {
                            "pattern": "^pgrep\\b"
                        },
                        {
                            "pattern": "^ps\\b"
                        },
                        {
                            "pattern": "^md5sum\\b"
                        }
                    ]
                },
                "fetch": {
                    "always_allow": [
                        {
                            "pattern": "^https?://api\\.github\\.com"
                        },
                        {
                            "pattern": "^https?://github\\.com"
                        },
                        {
                            "pattern": "^https?://raw\\.githubusercontent\\.com"
                        },
                        {
                            "pattern": "^https?://zed\\.dev"
                        },
                        {
                            "pattern": "^https?://docs\\.prefect\\.io"
                        },
                        {
                            "pattern": "^https?://docs\\.aws\\.amazon\\.com"
                        },
                        {
                            "pattern": "^https?://pypi\\.org"
                        },
                        {
                            "pattern": "^https?://aws\\.amazon\\.com"
                        },
                        {
                            "pattern": "^https?://docs\\.streamlit\\.io"
                        },
                        {
                            "pattern": "^https?://docs\\.snowflake\\.com"
                        },
                        {
                            "pattern": "^https?://docs\\.sqlalchemy\\.org"
                        },
                        {
                            "pattern": "^https?://docs\\.docker\\.com"
                        },
                        {
                            "pattern": "^https?://www\\.snowflake\\.com"
                        },
                        {
                            "pattern": "^https?://docs\\.python\\.org"
                        },
                        {
                            "pattern": "^https?://docs\\.github\\.com"
                        },
                        {
                            "pattern": "^https?://docs\\.aiohttp\\.org"
                        }
                    ]
                }
            }
        },
        "sandbox_permissions": {
            "network_hosts": [
                "docs.github.com",
                "docs.renovatebot.com",
                "github.com",
                "raw.githubusercontent.com",
                "docs.prefect.io",
                "docs.snowflake.com",
                "api.github.com",
                "zed.dev",
                "grep.app",
                "pypi.org",
                "reference.prefect.io",
                "peps.python.org",
                "docs.python.org",
                "devguide.python.org",
                "docs.aws.amazon.com",
                "aws.amazon.com",
                "deepmerge.readthedocs.io",
                "docs.astral.sh",
                "python-oracledb.readthedocs.io",
                "docs.sqlalchemy.org",
                "dlthub.com",
                "docs.streamlit.io",
                "docs.docker.com",
                "chardet.readthedocs.io",
                "www.snowflake.com",
                "ai.snowflake.com",
                "learn.microsoft.com",
                "filesystem-spec.readthedocs.io"
            ]
        },
        "enable_feedback": false,
        "favorite_models": [
            {
                "provider": "copilot_chat",
                "model": "gpt-6-astra",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "copilot_chat",
                "model": "gpt-6-luna",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "copilot_chat",
                "model": "gpt-6.1-sol",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "copilot_chat",
                "model": "claude-sonnet-5.5",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "copilot_chat",
                "model": "claude-opus-5.5",
                "enable_thinking": true,
                "effort": "high"
            }
        ],
        "dock": "right",
        "model_parameters": [],
        "default_model": {
            "effort": "high",
            "enable_thinking": true,
            "provider": "copilot_chat",
            "model": "claude-opus-5.5"
        },
        "inline_assistant_model": {
            "provider": "copilot_chat",
            "model": "gpt-5.6-luna"
        }
    },
    "debugger": {
        "button": false
    },
    "git_panel": {
        "dock": "left",
        "button": false
    },
    "status_bar": {
        "active_language_button": true,
        "cursor_position_button": true
    },
    "show_call_status_icon": false,
    "collaboration_panel": {
        "dock": "left",
        "button": false
    },
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": false
    },
    "use_smartcase_search": true,
