  "vim_mode": true,
  "autosave": "on_focus_change",
  "auto_update": false,
  "format_on_save": "on",
  "gutter": {
    "line_numbers": true
  },
  "ui_font_size": 13,
  "buffer_font_size": 12,
  "buffer_font_family": "Menlo",
  // "buffer_font_family": "Monocraft",
  "buffer_font_weight": 500,
  "ui_font_weight": 600,
  // "ui_font_family": "Monocraft",
  // "ui_font_family": "Menlo",
  "soft_wrap": "editor_width",
  "upload_binary_over_ssh": true,
  "tab_size": 4,
  "tab_bar": {
    "show": false
  },
  "terminal": {
    "font_family": "Menlo",
    // "font_family": "Monocraft",
    "line_height": {
      // 618 / 4 (https://zed.dev/docs/configuring-zed#terminal-line-height)
      "custom": 1.1545
    },
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/bash",
        "args": []
      }
    },
    "detect_venv": "off"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Dracula Solid"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "dock": "left",
    "default_width": 200,
    // "default_width": 10,
    "indent_size": 10,
    "indent_guides": {
      "show": "never"
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "languages": {
    "YAML": {
      "tab_size": 2,
      "formatter": "language_server"
    },
    "Dockerfile": {
      "tab_size": 4
    },
    "Python": {
      "language_servers": [
        // Enable ty, disable basedpyright, and enable all
        // other registered language servers (ruff, pylsp, pyright).
        "ty",
        "ruff"
        // "basedpyright"
        // "!pyright",
        // "..."
      ]
    }
  },
  "lsp": {
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true
        }
      }
    },
    "basedpyright": {
      "settings": {
        "python": {
          "analysis": {
            "typeCheckingMode": "off",
            "diagnosticMode": "openFilesOnly"
          }
        }
      }
    }
  },
  "file_types": {
    "TOML": ["**/*.conf"],
    "YAML": ["**/*.yaml.j2"],
    "Jinja2": ["j2"]
  }
}
