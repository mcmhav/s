{
  "disable_ai": false,
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot"
  },
  "outline_panel": {
    "dock": "left"
  },
  "agent": {
    "limit_content_width": true,
    "max_content_width": 800,
    "default_width": 640,
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://api\\.github\\.com"
            },
            {
              "pattern": "^https?://github\\.com"
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            },
            {
              "pattern": "^https?://zed\\.dev"
            },
            {
              "pattern": "^https?://docs\\.prefect\\.io"
            },
            {
              "pattern": "^https?://docs\\.aws\\.amazon\\.com"
            },
            {
              "pattern": "^https?://pypi\\.org"
            },
            {
              "pattern": "^https?://aws\\.amazon\\.com"
            },
            {
              "pattern": "^https?://docs\\.streamlit\\.io"
            },
            {
              "pattern": "^https?://docs\\.snowflake\\.com"
            },
            {
              "pattern": "^https?://docs\\.sqlalchemy\\.org"
            },
            {
              "pattern": "^https?://docs\\.docker\\.com"
            },
            {
              "pattern": "^https?://www\\.snowflake\\.com"
            }
          ]
        }
      }
    },
    "sandbox_permissions": {
      "network_hosts": [
        "docs.github.com",
        "docs.renovatebot.com",
        "github.com",
        "raw.githubusercontent.com",
        "docs.prefect.io",
        "docs.snowflake.com",
        "api.github.com",
        "zed.dev",
        "grep.app",
        "pypi.org",
        "reference.prefect.io",
        "peps.python.org",
        "docs.python.org",
        "devguide.python.org",
        "docs.aws.amazon.com",
        "aws.amazon.com",
        "deepmerge.readthedocs.io",
        "docs.astral.sh",
        "python-oracledb.readthedocs.io",
        "docs.sqlalchemy.org",
        "dlthub.com",
        "docs.streamlit.io",
        "docs.docker.com",
        "chardet.readthedocs.io",
        "www.snowflake.com",
        "ai.snowflake.com"
      ]
    },
    "sidebar_side": "right",
    "enable_feedback": false,
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.6-luna",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.8",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-4.5",
        "enable_thinking": true
      }
    ],
    "dock": "right",
    "model_parameters": [],
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5.6-sol"
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.6-luna"
    }
  },
  "debugger": {
    "button": false
  },
  "git_panel": {
    "dock": "left",
    "button": false
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true
  },
  "show_call_status_icon": false,
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },
  "use_smartcase_search": true,
  // https://zed.dev/schema/themes/v0.2.0.json
