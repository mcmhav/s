#!/usr/bin/env bash

REQS_FILE_PATH="$1"

# Shared with the `csys install` calls below, so each package is set up once per run.
if [ -z "$CSYS_RUN_DIR" ]; then
  CSYS_RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/csys-run-XXXXXX")"
  export CSYS_RUN_DIR
  trap 'rm -rf "$CSYS_RUN_DIR"' EXIT
fi

REQS_COUNT=$(wc -l "$REQS_FILE_PATH" | awk '{print $1}')

loggit "Reqs to setup: $REQS_COUNT"

# TODO: issue with while-loop and brew install?
# while read -ra l; do
export IFS=$'\n'
for l in $(cat $REQS_FILE_PATH); do
  # cat "$REQS_FILE_PATH" | while read -r l; do
  loggit dbug "Installing reqs: $l"
  if [ "${l%"${l#?}"}" == "#" ]; then
    loggit dbug "Skipping: ${l[*]}"
    continue
  elif [[ "$l" == sudo\|* ]]; then
    loggit dbug "Needs sudo: $l"
    if have_sudo_access; then
      sudo csys install "${l[@]/sudo|/}"
    fi
  else
    csys install "${l[@]}"
  fi
done
# done <"$REQS_FILE_PATH"
